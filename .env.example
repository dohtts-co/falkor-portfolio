# Copy this file to .env and fill in your values.
# Never commit .env — it contains secrets.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_string

# ── Supabase (https://supabase.com → your project → Settings → API) ──────────
# Production store. Leave both blank for local dev and the app falls back to
# ./data.json on disk.
#
# Project URL, e.g. https://abcdefghijk.supabase.co
SUPABASE_URL=

# service_role key — server-side only, NEVER expose it in the browser or commit
# it. Settings → API Keys → service_role (reveal). Not the anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary (https://cloudinary.com → Dashboard) ──────────────────────────
# Cloud name:   top-left of the Cloudinary dashboard (e.g. "dxyz123abc")
CLOUDINARY_CLOUD_NAME=your_cloud_name

# API key & secret: Dashboard → Settings → API Keys → Generate New Key
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Contact form (https://resend.com → API Keys) ─────────────────────────────
RESEND_API_KEY=
CONTACT_EMAIL=falkorjp@gmail.com

# ── Local file store (dev only) ───────────────────────────────────────────────
# Ignored when SUPABASE_URL is set. Blank = ./data.json
DATA_PATH=
