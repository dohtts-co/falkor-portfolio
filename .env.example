# Copy this file to .env and fill in your values.
# Never commit .env — it contains secrets.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_string

# ── Cloudinary (https://cloudinary.com → Dashboard) ──────────────────────────
# Cloud name:   top-left of the Cloudinary dashboard (e.g. "dxyz123abc")
CLOUDINARY_CLOUD_NAME=your_cloud_name

# API key & secret: Dashboard → Settings → API Keys → Generate New Key
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: leave empty (uses ./data.json)
# Railway:   /data/data.json   (matches the Volume mount path)
DATA_PATH=
